{
  "name": "cia-code",
  "version": "1.0.0",
  "description": "Cia Code — IDE IA nouvelle génération",
  "main": "src/main/main.js",
  "homepage": "./",
  "scripts": {
    "start": "node start.js",
    "electron-wait": "wait-on http://localhost:3000 && electron .",
    "react-start": "react-scripts start",
    "react-build": "react-scripts build",
    "electron": "electron .",
    "obfuscate": "node scripts/obfuscate.js",
    "obfuscate:bat": "node scripts/obfuscate-bat.js",
    "obfuscate:all": "npm run obfuscate && npm run obfuscate:bat",
    "restore": "node scripts/restore.js",
    "restore:bat": "node scripts/restore-bat.js",
    "restore:all": "npm run restore && npm run restore:bat",
    "build": "npm run react-build && npm run obfuscate:all && electron-builder",
    "build:dist": "npm run react-build && npm run obfuscate:all && electron-builder --win",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.cia.code",
    "productName": "Cia Code",
    "asar": true,
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "files": [
      "build/**/*",
      "src/main/**/*",
      "!src/_originals/**/*",
      "public/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "public",
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@monaco-editor/react": "^4.6.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.45.0",
    "node-pty": "^1.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-web-links": "^0.9.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "concurrently": "^8.2.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "javascript-obfuscator": "^5.5.0",
    "react-scripts": "5.0.1",
    "wait-on": "^7.2.0"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "allowScripts": {
    "electron@28.3.3": true,
    "node-pty@1.1.0": true
  }
}
